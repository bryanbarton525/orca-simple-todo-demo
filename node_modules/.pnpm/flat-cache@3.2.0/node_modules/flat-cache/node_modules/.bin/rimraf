#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/rimraf@3.0.2/node_modules/rimraf/node_modules:/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/rimraf@3.0.2/node_modules:/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/rimraf@3.0.2/node_modules/rimraf/node_modules:/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/rimraf@3.0.2/node_modules:/var/lib/go-orca/workspaces/e7fac64a-0373-4e32-9d1d-eae6896aa770/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../rimraf@3.0.2/node_modules/rimraf/bin.js" "$@"
else
  exec node  "$basedir/../../../../../rimraf@3.0.2/node_modules/rimraf/bin.js" "$@"
fi
